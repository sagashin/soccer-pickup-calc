rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 家族グループ同期: 一覧列挙(list)・全削除(delete)を禁止し、スキーマ・サイズを厳格検証
    // NOTE: 既存の短い合言葉との後方互換のため length >= 4 を許可している。
    //       より強固にする場合は Firebase Console で匿名認証を有効化し request.auth != null を追加する。
    match /families/{familyId} {
      allow list: if false;
      allow delete: if false;
      allow get: if familyId.size() >= 4 && familyId.size() <= 64;
      allow create, update: if familyId.size() >= 4 && familyId.size() <= 64
        && request.resource.data.keys().hasOnly([
          'schedules',
          'venueDocs',
          'fitnessRecords',
          'coachNotes',
          'deletedIds',
          'updatedAt',
          'lastUpdatedBy',
          'schemaVersion'
        ])
        && request.resource.data.schedules is list
        && request.resource.data.schedules.size() <= 150
        && request.resource.data.venueDocs is list
        && request.resource.data.venueDocs.size() <= 60
        && request.resource.data.fitnessRecords is list
        && request.resource.data.fitnessRecords.size() <= 150
        && request.resource.data.coachNotes is list
        && request.resource.data.coachNotes.size() <= 60
        && request.resource.data.deletedIds is map
        && request.resource.data.updatedAt is number
        && request.resource.data.lastUpdatedBy is string
        && request.resource.data.lastUpdatedBy.size() <= 50
        && request.resource.data.schemaVersion is number;
    }

    // LINE共有用 一時スナップショット（追記のみ・上書き/一覧取得/削除不可）
    match /shares/{shareId} {
      allow list, update, delete: if false;
      allow get: if shareId.size() >= 16 && shareId.size() <= 64
        && resource.data.expiresAt > request.time.toMillis();
      allow create: if shareId.size() >= 16 && shareId.size() <= 64
        && request.resource.data.keys().hasOnly(['payload', 'createdAt', 'expiresAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() > 0
        && request.resource.data.payload.size() <= 120000
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400 * 1000;
    }
  }
}
